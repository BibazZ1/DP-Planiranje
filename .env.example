# Kopiraj u .env i popuni vrijednosti. .env NIKAD ne ide u git!
API_SECRET_KEY=

# Microsoft Entra (Azure AD) prijava
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
APP_DOMAIN=https://dp-planiranje.mih-kontroling.com
PERMANENT_ADMIN=e.uzunovic@gfcbh.ba

# Cloudflare tunel (Zero Trust -> Networks -> Tunnels -> token)
CLOUDFLARE_TUNNEL_TOKEN=

# GitHub auto-deploy (isti princip kao ULAZNE-FAKTURE): kontejner povlači main granu
# i graceful reloada gunicorn — izmjene koda idu samo kroz `git push` + DEPLOY.bat.
# GITHUB_TOKEN = PAT s pristupom privatnom repo-u BibazZ1/DP-Planiranje (read).
GITHUB_TOKEN=

# Postgres (vlastita baza, odvojena od ULAZNE-FAKTURE)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=DP-PLANIRANJE
POSTGRES_USER=dp_planiranje
POSTGRES_PASSWORD=

# SMTP (sedmicni digest ponedjeljkom + eskalacijski mailovi)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Azure SQL (read-only sync projekata)
SQL_SERVER=mihtest.database.windows.net
SQL_DATABASE=Data Analyst
SQL_UID=
SQL_PWD=

# Lokalni razvoj bez Azure prijave (NE radi u Dockeru):
# DEV_FAKE_USER=e.uzunovic@gfcbh.ba
